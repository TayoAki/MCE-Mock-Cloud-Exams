# Base URL of the CertPath API, including /v1.
#
# Leave unset in development: the backoffice calls /v1 on its own origin and the
# Vite dev/preview server proxies it to API_PROXY_TARGET (default
# http://127.0.0.1:4000). That also works in GitHub Codespaces.
#
# Set it for a production build served without that proxy:
# VITE_API_URL=https://api.example.com/v1
