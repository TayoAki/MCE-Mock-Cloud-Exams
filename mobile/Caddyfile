# Serves the learner web app and proxies /v1 to the API (API_UPSTREAM, e.g.
# http://api.railway.internal:4000), so the app calls its own origin.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	handle /v1/* {
		reverse_proxy {$API_UPSTREAM} {
			# Pass on the client address the platform's edge recorded: the API trusts one proxy hop.
			header_up X-Forwarded-For {header.X-Forwarded-For}
		}
	}

	handle {
		root * /srv
		# Bundles are content-hashed; the HTML always revalidates.
		header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
