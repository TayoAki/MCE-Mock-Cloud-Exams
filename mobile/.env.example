# Base URL of the CertPath API, including /v1.
#
# Leave unset in development: the app calls Metro, and metro.config.js proxies
# /v1 to the API at API_PROXY_TARGET (default http://127.0.0.1:4000). That works
# for web, simulators, phones on the same network, tunnels and GitHub Codespaces.
#
# Set it for production builds, or to bypass the proxy:
# EXPO_PUBLIC_API_URL=https://api.example.com/v1
