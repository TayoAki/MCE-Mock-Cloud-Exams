# Copy to .env. Every value here is optional for `npm run dev`, which starts an
# in-memory MongoDB replica set and seeds it when MONGODB_URI is unset.
PORT=4000
NODE_ENV=development

# MongoDB must be a replica set: answer grading and session completion use
# multi-document transactions. docker-compose.yml at the repo root provides one.
# MONGODB_URI=mongodb://localhost:27017/certpath?replicaSet=rs0

# Required outside development. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_TTL=30d

# Comma-separated origins allowed to call the API from a browser (admin app, Expo web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# AI tutor and explanations. Without a key the API uses reviewed hints and rationales.
# Set ANTHROPIC_API_KEY to call Anthropic directly, or OPENROUTER_API_KEY to go through
# OpenRouter instead (Anthropic wins if both are set).
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# default | none | minimal | low | medium | high
OPENROUTER_REASONING_EFFORT=minimal
AI_DAILY_CALLS_PER_USER=20
AI_DAILY_CALLS_GLOBAL=2000
AI_TIMEOUT_MS=20000

# Plus. Off (the default) means CertPath is free: every learner has every feature,
# and the preview and store purchases are refused. Turn it on once billing exists.
PLUS_ENABLED=false

# Store purchases (only with PLUS_ENABLED=true). Real Apple/Google verification is not implemented; the sandbox
# verifier accepts tokens shaped `sandbox:<product_id>:<transaction_id>`.
STORE_SANDBOX=true

# Expo push delivery for opted-in reminders. Off by default; jobs are still planned
# and recorded so eligibility can be inspected.
EXPO_PUSH_ENABLED=false

# Require a second staff member to approve each question before publication.
SEPARATE_REVIEWER=false

# Deep link base used for study-circle invites.
INVITE_URL_BASE=certpath://join

# Days between a deletion request and the deletion worker removing data.
DELETION_GRACE_DAYS=7

# Load the pilot content and the admin account into an empty database when the API
# starts (no demo learner). A no-op once the content exists; it never resets the
# admin password. In production SEED_ADMIN_PASSWORD must be 16+ characters.
SEED_ON_START=false

# Seed credentials. The demo learner is created by `npm run dev` and `npm run seed` only.
SEED_ADMIN_EMAIL=admin@certpath.dev
SEED_ADMIN_PASSWORD=certpath-admin
SEED_DEMO_EMAIL=alex@certpath.dev
SEED_DEMO_PASSWORD=certpath-demo
